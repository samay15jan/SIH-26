{
  "name": "nirmaan-backend",
  "version": "1.0.0",
  "description": "Nirmaan - Smart Mining Safety and Structural Monitoring backend (SIH 2026)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "simulate": "node scripts/simulate.js",
    "publish:sample": "node scripts/publish-sample.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  },
  "license": "MIT"
}
