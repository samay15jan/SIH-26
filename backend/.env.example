# ---------- Server ----------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# ---------- PostgreSQL ----------
# Local (docker compose): postgres service is reachable as "postgres" from the backend container
DATABASE_URL=postgres://nirmaan:nirmaan@localhost:5432/nirmaan
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000

# ---------- MQTT ----------
# Existing broker - do not run your own
MQTT_URL=mqtt://mqtt.samay15jan.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=nirmaan-backend
MQTT_TOPIC_PREFIX=nirmaan
MQTT_QOS=1
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_ENABLED=true
# Max in-flight messages processed concurrently by the ingestion pipeline
MQTT_INGEST_CONCURRENCY=8
MQTT_INGEST_QUEUE_MAX=5000

# ---------- Device liveness ----------
NODE_OFFLINE_AFTER_SECONDS=180
GATEWAY_OFFLINE_AFTER_SECONDS=300
MONITOR_INTERVAL_SECONDS=30

# ---------- Telemetry / retention ----------
TELEMETRY_MAX_LIMIT=5000
TELEMETRY_FUTURE_SKEW_SECONDS=300
PARTITION_MONTHS_AHEAD=1

# ---------- Rule engine defaults ----------
# These seed the alert_rules table on first run; runtime values are read from the DB
RULES_REFRESH_SECONDS=60
